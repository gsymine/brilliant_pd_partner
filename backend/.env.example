# ---- ZooWork --------------------------------------------------------------
ZOOWORK_API_KEY=
# ZOOWORK_BASE_URL=            # optional; SDK default already ends in /service/v1
# ZOOWORK_MODEL=               # optional; default = platform's selectable default model
PD_AGENT_LABEL_ENV=dev         # agents are found again by labels app/env/role

# ---- Outbound email (SMTP) ------------------------------------------------
EMAIL_MODE=smtp                # smtp = really send | dry_run = record only, nothing leaves
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl              # ssl | starttls | none
SMTP_USER=sourcing@example.com
SMTP_PASSWORD=                 # app password, not your login password
EMAIL_FROM_ADDRESS=sourcing@example.com
EMAIL_FROM_NAME=Sourcing Team

# ---- Inbound email (IMAP polling) -----------------------------------------
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER / IMAP_PASSWORD default to the SMTP credentials
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60
# INBOUND_TOKEN=               # set to enable POST /inbound-email (webhook / manual testing)

# ---- Conversation limits --------------------------------------------------
PD_REMINDER_AFTER_HOURS=48
PD_MAX_REMINDERS=2
PD_MAX_OUTBOUND_PER_VENDOR=8
PD_RUN_DEADLINE_HOURS=168
PD_TICK_SECONDS=300

# ---- Vendor simulator (demo) ----------------------------------------------
# Vendors whose address ends in .sim (simulator/vendors.json) are answered by app/vendor_sim.py;
# their mail never leaves the backend. Real addresses in the same run still use SMTP/IMAP.
SIM_MODE=llm                   # llm = ZooWork agent writes the wording | scripted = templates | off
SIM_SPEED=1.0                  # multiplier on each vendor's reply delay (0 = instant)
# Demo timing (compressed): reminders after ~30 s, timer every 10 s, run closes after 1 h
# PD_REMINDER_AFTER_HOURS=0.008
# PD_TICK_SECONDS=10
# PD_MAX_REMINDERS=1
